<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Assets Definition -->
    <template id="assets_frontend" inherit_id="website.assets_frontend" name="Shadcn Theme Assets">
        <xpath expr="." position="inside">
            <!-- Theme Styles -->
            <link rel="stylesheet" type="text/scss" href="/theme_shadcn/static/src/scss/theme.scss"/>
            <!-- Theme Scripts -->
            <script type="text/javascript" src="/theme_shadcn/static/src/js/theme.js"/>
        </xpath>
    </template>

    <!-- Custom Header -->
    <template id="header" name="Shadcn Header" inherit_id="website.layout" active="False" customize_show="True">
        <xpath expr="//header//nav" position="replace">
            <nav class="navbar navbar-expand-lg navbar-light">
                <div class="container">
                    <a class="navbar-brand" href="/">
                        <span t-field="res_company.name">Company Name</span>
                    </a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                        <span class="navbar-toggler-icon"/>
                    </button>
                    <div class="collapse navbar-collapse" id="navbarNav">
                        <ul class="navbar-nav ms-auto">
                            <li class="nav-item">
                                <a class="nav-link active" href="/">Home</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="/page/about-us">About</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="/page/services">Services</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="/contactus">Contact</a>
                            </li>
                        </ul>
                        <div class="ms-3">
                            <a href="/web/login" class="btn btn-outline-primary">Login</a>
                        </div>
                    </div>
                </div>
            </nav>
        </xpath>
    </template>

    <!-- Custom Footer -->
    <template id="footer" name="Shadcn Footer" inherit_id="website.layout" active="False" customize_show="True">
        <xpath expr="//div[@id='footer']" position="replace">
            <div id="footer" class="oe_structure oe_structure_solo">
                <footer>
                    <div class="container">
                        <div class="row">
                            <div class="col-lg-4 mb-4 mb-lg-0">
                                <h5 t-field="res_company.name">Company Name</h5>
                                <p class="text-muted mb-3">
                                    Building modern, beautiful web experiences with Odoo.
                                </p>
                                <div class="social-links">
                                    <a href="#" class="me-2"><i class="fa fa-facebook"/></a>
                                    <a href="#" class="me-2"><i class="fa fa-twitter"/></a>
                                    <a href="#" class="me-2"><i class="fa fa-linkedin"/></a>
                                    <a href="#"><i class="fa fa-instagram"/></a>
                                </div>
                            </div>
                            <div class="col-lg-2 col-md-6 mb-4 mb-lg-0">
                                <h5>Company</h5>
                                <ul class="list-unstyled">
                                    <li><a href="/page/about-us">About Us</a></li>
                                    <li><a href="/page/services">Services</a></li>
                                    <li><a href="/page/team">Team</a></li>
                                    <li><a href="/page/careers">Careers</a></li>
                                </ul>
                            </div>
                            <div class="col-lg-2 col-md-6 mb-4 mb-lg-0">
                                <h5>Resources</h5>
                                <ul class="list-unstyled">
                                    <li><a href="/blog">Blog</a></li>
                                    <li><a href="/forum">Forum</a></li>
                                    <li><a href="/page/documentation">Documentation</a></li>
                                    <li><a href="/page/support">Support</a></li>
                                </ul>
                            </div>
                            <div class="col-lg-2 col-md-6 mb-4 mb-lg-0">
                                <h5>Legal</h5>
                                <ul class="list-unstyled">
                                    <li><a href="/page/privacy-policy">Privacy Policy</a></li>
                                    <li><a href="/page/terms">Terms of Service</a></li>
                                    <li><a href="/page/cookies">Cookie Policy</a></li>
                                </ul>
                            </div>
                            <div class="col-lg-2 col-md-6">
                                <h5>Connect</h5>
                                <ul class="list-unstyled">
                                    <li><a href="/contactus">Contact Us</a></li>
                                    <li><a href="/page/locations">Locations</a></li>
                                    <li><a href="mailto:info@example.com">Email</a></li>
                                </ul>
                            </div>
                        </div>
                        <div class="footer-bottom text-center">
                            <p class="mb-0">
                                © <span t-esc="datetime.datetime.now().year"/> 
                                <span t-field="res_company.name">Company Name</span>. 
                                All rights reserved. Powered by Odoo with Shadcn Theme.
                            </p>
                        </div>
                    </div>
                </footer>
            </div>
        </xpath>
    </template>
</odoo>
